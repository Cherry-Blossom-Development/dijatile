; Copy this to platformio_local.ini (git-ignored) and fill in your boards.
;
; Each environment uploads to the board with this USB serial number, wherever it is
; plugged in (scripts/select_port.py). The serial number is the chip's MAC: run
;   pio device list
; and look for SER= on the "USB JTAG/serial debug unit" lines. The tile's name
; (dj-XXXX, shown in the Nearby app and on serial) is the last two bytes.
; If the board isn't plugged in, the upload stops instead of flashing another tile.

[env:TheRoundOne]
custom_usb_serial = XX:XX:XX:XX:XX:XX

[env:TheSquareOne]
custom_usb_serial = XX:XX:XX:XX:XX:XX

[env:TheControlsOne]
custom_usb_serial = XX:XX:XX:XX:XX:XX
